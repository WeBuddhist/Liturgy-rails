# Obsidian workspace state (per-machine, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# System junk
.trash/
.DS_Store

# Python
__pycache__/
*.pyc
.venv
.env
.env.local
**/.env.local

# vendored toolchain: generated payloads and caches
# payloads/ sits directly under scripts/, so the */output/ glob misses it —
# it is regenerated wholesale from 1-SOURCES/Text on every build.
4-SYSTEM/scripts/payloads/
4-SYSTEM/scripts/payloads-translations/
4-SYSTEM/scripts/*/output/
4-SYSTEM/scripts/**/__pycache__/
